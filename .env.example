# =============================================================================
# CONFIGURACIÓN DE ESCALADO DINÁMICO - EJEMPLO
# =============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno

# === ESCALADO DINÁMICO ===
# Habilitar/deshabilitar escalado automático de workers
DYNAMIC_SCALING_ENABLED=true

# Límites de seguridad del sistema (porcentajes)
# El sistema reducirá workers si se superan estos límites
CPU_THRESHOLD=80
MEMORY_THRESHOLD=80

# === TRIGGERS INMEDIATOS ===
# Umbrales críticos para triggers inmediatos (porcentajes)
CRITICAL_CPU_THRESHOLD=85
CRITICAL_MEMORY_THRESHOLD=85

# Umbral para detectar picos súbitos de carga (porcentaje de aumento)
SPIKE_THRESHOLD=20

# Intervalo mínimo entre checks inmediatos (segundos)
IMMEDIATE_CHECK_INTERVAL=5

# === CONFIGURACIÓN DE CELERY ===
# Configuración automática basada en hardware detectado
# Estos valores se calculan automáticamente, pero pueden sobrescribirse

# Rango de workers para autoscale (formato: max,min)
# Con GPU: típicamente 6,1
# Sin GPU: típicamente 4,1
# CELERY_WORKER_AUTOSCALER=6,1

# Concurrencia por worker (calculado automáticamente)
# Con GPU: 1-2 workers concurrentes
# Sin GPU: 2-4 workers concurrentes según RAM
# CELERY_WORKER_CONCURRENCY=2

# === CONFIGURACIÓN DE REDIS ===
# Para desarrollo local con Docker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Para producción (ajustar según tu configuración)
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=your-redis-password

# === CONFIGURACIÓN DE EMAIL ===
# Para notificaciones del sistema (opcional)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# === CONFIGURACIÓN DE ENTORNO ===
# Entorno de ejecución
DJANGO_ENV=development
# DJANGO_ENV=production

# === CONFIGURACIÓN DE DOCKER ===
# Límites de recursos para contenedores
DOCKER_CPU_LIMIT=0.8
DOCKER_MEMORY_LIMIT=2g
DOCKER_CPU_RESERVATION=0.2
DOCKER_MEMORY_RESERVATION=512m

# === CONFIGURACIÓN DE MONITOREO ===
# Intervalo de verificación del middleware (segundos)
SYSTEM_CHECK_INTERVAL=30

# Umbrales para baja carga (porcentajes)
LOW_LOAD_CPU_THRESHOLD=50
LOW_LOAD_MEMORY_THRESHOLD=50

# === CONFIGURACIÓN DE LOGGING ===
# Nivel de logging para escalado dinámico
SCALING_LOG_LEVEL=INFO
# SCALING_LOG_LEVEL=DEBUG  # Para más detalle

# === CONFIGURACIÓN AVANZADA ===
# Tiempo de espera antes de aplicar escalado (segundos)
SCALING_COOLDOWN_SECONDS=60

# Número máximo de cambios de escalado por hora
MAX_SCALING_CHANGES_PER_HOUR=10

# Habilitar escalado agresivo en sistemas con GPU
AGGRESSIVE_GPU_SCALING=true

# === EJEMPLOS DE CONFIGURACIÓN POR ENTORNO ===

# DESARROLLO LOCAL (recursos limitados)
# DYNAMIC_SCALING_ENABLED=true
# CPU_THRESHOLD=70
# MEMORY_THRESHOLD=70
# CELERY_WORKER_AUTOSCALER=3,1

# PRODUCCIÓN (servidor dedicado)
# DYNAMIC_SCALING_ENABLED=true
# CPU_THRESHOLD=85
# MEMORY_THRESHOLD=85
# CELERY_WORKER_AUTOSCALER=8,2

# CLOUD (escalado automático)
# DYNAMIC_SCALING_ENABLED=true
# CPU_THRESHOLD=80
# MEMORY_THRESHOLD=80
# CELERY_WORKER_AUTOSCALER=12,1

# =============================================================================
# NOTAS IMPORTANTES:
# =============================================================================
# 1. Los valores se calculan automáticamente basados en tu hardware
# 2. GPU detectada = configuración optimizada para GPU
# 3. Solo CPU = configuración optimizada para CPU según RAM disponible
# 4. El middleware monitorea cada 30 segundos por defecto
# 5. Los workers se escalan automáticamente según la carga
# 6. Los límites de seguridad previenen saturación del sistema
# =============================================================================